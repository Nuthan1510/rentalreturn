# Copy to .env
PORT=5000

# Leave MONGODB_URI empty to auto-start a temporary in-memory MongoDB (great for demos).
# For real persistence use a local server or MongoDB Atlas, e.g.
# MONGODB_URI=mongodb://127.0.0.1:27017/rentalreturn
MONGODB_URI=

# Seed demo equipment + rentals when the database is empty (true/false)
SEED=true

# Late fee multiplier applied to the daily rate for every day an item is overdue
LATE_FEE_MULTIPLIER=1.5
